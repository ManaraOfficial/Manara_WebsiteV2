# EmailJS — contact form delivery.
# Copy this file to `.env` and fill in the values from https://dashboard.emailjs.com
#
#   Service ID   : Email Services  -> your service
#   Template ID  : Email Templates -> your template
#   Public Key   : Account -> General -> Public Key
#
# These are bundled into the client at build time and are visible to anyone who
# views the site. That is expected for EmailJS: the public key is not a secret.
# Restrict abuse in the dashboard instead — Account -> Security -> allow-list
# your domain, and leave "Use Private Key" off (a private key cannot be used
# from browser code).
#
# The contact form's template needs these variables:
#   {{from_name}} {{phone}} {{address}} {{topic}} {{message}} {{to_email}}
#
# With any of these unset the form refuses to submit and shows an error telling
# the visitor to email directly — it never reports a success it cannot deliver.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
